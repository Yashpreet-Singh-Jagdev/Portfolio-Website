---

<section class="section" id="contact">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        Get In Touch
      </span>
      <h2 class="section-title">Let's Build Something Meaningful</h2>
      <p class="section-desc">
        I am currently seeking software engineering opportunities, internships, and high-impact engineering collaborations. Feel free to reach out directly.
      </p>
    </div>

    <div class="contact-card-box card">
      <div class="contact-main">
        <h3 class="contact-box-title">Start a Conversation</h3>
        <p class="contact-box-desc">
          Whether you have an open engineering role, a technical question, or an exciting project idea, my inbox is always open.
        </p>

        <div class="contact-grid">
          {contactMethods.map((m) => (
            <div class="contact-tile">
              <div class="tile-icon" set:html={m.icon} />
              <div class="tile-content">
                <span class="tile-label">{m.label}</span>
                <span class="tile-value">{m.value}</span>
              </div>
              <div class="tile-actions">
                <a 
                  href={m.href} 
                  target={m.href.startsWith('http') ? "_blank" : undefined}
                  rel={m.href.startsWith('http') ? "noopener noreferrer" : undefined}
                  class="btn btn-secondary tile-btn"
                  title={m.action}
                >
                  {m.action}
                </a>
                {m.isCopyable && (
                  <button 
                    type="button" 
                    class="btn btn-ghost copy-tile-btn" 
                    data-copy-val={m.value}
                    aria-label={`Copy ${m.label}`}
                    title={`Copy ${m.label}`}
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                    </svg>
                  </button>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-card-box {
    padding: 2.25rem;
    background-color: var(--bg-card);
  }

  .contact-box-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
    letter-spacing: -0.02em;
  }

  .contact-box-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-bottom: 2rem;
    max-width: 600px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .contact-tile {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .contact-tile:hover {
    border-color: var(--border-hover);
    background-color: var(--bg-card);
  }

  .tile-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background-color: var(--accent-subtle);
    color: var(--accent);
    flex-shrink: 0;
  }

  .tile-content {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    flex-grow: 1;
  }

  .tile-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .tile-value {
    font-size: 0.8875rem;
    font-weight: 500;
    color: var(--text-primary);
    font-family: var(--font-mono);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tile-actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
  }

  .tile-btn {
    font-size: 0.775rem;
    padding: 0.35rem 0.65rem;
  }

  .copy-tile-btn {
    padding: 0.35rem;
    border-radius: 6px;
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 500px) {
    .contact-tile {
      flex-wrap: wrap;
    }
    .tile-actions {
      width: 100%;
      justify-content: flex-end;
      padding-top: 0.4rem;
    }
  }
</style>

<script>
  document.querySelectorAll('.copy-tile-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const val = (btn as HTMLElement).dataset.copyVal;
      if (val) {
        navigator.clipboard.writeText(val).then(() => {
          // @ts-ignore
          if (window.showToast) {
            // @ts-ignore
            window.showToast(`${val} copied to clipboard!`);
          }
        });
      }
    });
  });
</script>
