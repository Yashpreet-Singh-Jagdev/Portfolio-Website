---
const skillCategories = [
  {
    category: "Primary Stack",
    description: "Core languages and frameworks utilized daily for production and client applications.",
    skills: ["TypeScript", "Node.js", "Express.js", "MongoDB", "React.js"]
  },
  {
    category: "Backend & Systems",
    description: "Systems programming, asynchronous web APIs, and relational/document databases.",
    skills: ["Python", "FastAPI", "C++", "SQLite", "RESTful APIs", "Swagger / OpenAPI"]
  },
  {
    category: "DevOps & Cloud",
    description: "Cloud storage orchestration, containerization, and continuous integration workflows.",
    skills: ["Azure Blob Storage", "Azure Portal", "Docker", "GitHub Actions", "CI/CD Pipelines"]
  },
  {
    category: "Testing, Tools & SEO",
    description: "Automated unit/integration testing suites, developer tooling, and search optimization.",
    skills: ["Vitest", "PyTest", "Postman", "Git", "GitHub", "Search Engine Optimization (SEO)", "VTKJS"]
  }
];
---

<section class="section" id="skills">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="4 17 10 11 4 5"></polyline>
          <line x1="12" y1="19" x2="20" y2="19"></line>
        </svg>
        Technical Arsenal
      </span>
      <h2 class="section-title">Skills & Technologies</h2>
      <p class="section-desc">
        A comprehensive overview of languages, frameworks, cloud infrastructure, and automated testing tools in my daily workflow.
      </p>
    </div>

    <div class="skills-grid">
      {skillCategories.map((cat) => (
        <div class="card skill-card">
          <h3 class="skill-category-title">{cat.category}</h3>
          <p class="skill-category-desc">{cat.description}</p>
          <div class="skill-pill-container">
            {cat.skills.map((s) => (
              <span class="pill pill-tech">{s}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .skill-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
  }

  .skill-category-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
    letter-spacing: -0.01em;
  }

  .skill-category-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .skill-pill-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pill-tech {
    font-size: 0.8125rem;
    padding: 0.35rem 0.75rem;
  }

  @media (max-width: 680px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
