---

<section class="section hero-section" id="about">
  <div class="container">
    <div class="hero-header-row">
      
    </div>

    <div class="hero-content">
      <h1 class="hero-title">
        Yashpreet Singh Jagdev
      </h1>
      <p class="hero-role">
        Software Engineer & Full Stack Developer
      </p>

      <p class="hero-bio">
        Information Technology undergraduate at JECRC Foundation. I engineer resilient backend services, 
        production-grade web applications, and AI integrations (RAG & LLMs) using TypeScript, Node.js, 
        FastAPI, and modern cloud infrastructure.
      </p>

      <!-- Action CTAs -->
      <div class="hero-actions">
        <a href="#contact" class="btn btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          Get in Touch
        </a>
        
        <button type="button" id="copy-email-hero-btn" class="btn btn-secondary" aria-label="Copy email address to clipboard">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          Copy Email
        </button>

        <a 
          href="https://github.com/Yashpreet-Singh-Jagdev" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-secondary"
          aria-label="GitHub Profile"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
          GitHub
        </a>

        <a 
          href="https://www.linkedin.com/in/yashpreet-singh-jagdev-1751b0253/" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-secondary"
          aria-label="LinkedIn Profile"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
          LinkedIn
        </a>
      </div>

      <!-- Quick Metrics Strip -->
      <div class="hero-stats-grid">
        <div class="stat-card">
          <div class="stat-number">2</div>
          <div class="stat-label">Software Engineering Internships</div>
          <div class="stat-sub">Quabyt Tech & TappyTray</div>
        </div>

        <div class="stat-card">
          <div class="stat-number">1st <span class="stat-accent">Runner-up</span></div>
          <div class="stat-label">Smart India Hackathon '24</div>
          <div class="stat-sub">Prelims (vs 177 Teams)</div>
        </div>

        <div class="stat-card">
          <div class="stat-number">Rank <span class="stat-accent">#4</span></div>
          <div class="stat-label">MNIT SphinX'24 Hackathon</div>
          <div class="stat-sub">2,000+ Participants</div>
        </div>

        <div class="stat-card">
          <div class="stat-number">Rank <span class="stat-accent">#6</span></div>
          <div class="stat-label">JECRC Innov8'24 Hackathon</div>
          <div class="stat-sub">700+ Teams (20+ States)</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: 4.5rem;
    padding-bottom: 4rem;
  }

  .hero-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .location-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .hero-title {
    font-size: 3.25rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .hero-role {
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--text-secondary);
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }

  .hero-bio {
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--text-secondary);
    max-width: 720px;
    margin-bottom: 2.25rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 3.5rem;
  }

  /* Metric cards */
  .hero-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .stat-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 1.25rem;
    transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .stat-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-hover);
    box-shadow: var(--shadow-sm);
  }

  .stat-number {
    font-size: 1.5rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--text-primary);
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }

  .stat-accent {
    font-size: 1.05rem;
    color: var(--accent);
    font-weight: 600;
  }

  .stat-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.35;
    margin-bottom: 0.15rem;
  }

  .stat-sub {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  @media (max-width: 860px) {
    .hero-stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: 2.35rem;
    }
    .hero-role {
      font-size: 1.15rem;
    }
    .hero-bio {
      font-size: 1rem;
    }
    .hero-stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const heroCopyBtn = document.getElementById('copy-email-hero-btn');
  heroCopyBtn?.addEventListener('click', () => {
    navigator.clipboard.writeText('yashpreet369@gmail.com').then(() => {
      // @ts-ignore
      if (window.showToast) {
        // @ts-ignore
        window.showToast('Email (yashpreet369@gmail.com) copied!');
      }
    });
  });
</script>
