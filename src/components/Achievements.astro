---
const achievements = [
  {
    rank: "1st Runner-up",
    event: "Smart India Hackathon '24 Prelims",
    highlight: "Outperformed 177 qualified teams nationwide",
    description: "Awarded 2nd Rank for architecting Yatri Sakha, an AI-enhanced Rail Madad grievance management and prioritization system integrating PNR validation and Gemini AI.",
    badge: "National Hackathon",
    year: "2024"
  },
  {
    rank: "4th Position (Finalist)",
    event: "MNIT SphinX'24 Hackathon",
    highlight: "Led engineering team against 2,000+ competitors",
    description: "Built and pitched Perspectify, a dynamic RAG chatbot engine delivering multi-persona conversational insights with real-time news retrieval.",
    badge: "National Hackathon",
    year: "2024"
  },
  {
    rank: "6th Position",
    event: "JECRC University Innov8'24 Hackathon",
    highlight: "Competed against 700+ teams across 20+ states",
    description: "Demonstrated full-stack scalability, real-time fallbacks, and innovative AI UX to domain jury panels and industry executives.",
    badge: "Inter-State Hackathon",
    year: "2024"
  },
  {
    rank: "Core Technical Team",
    event: "JECRC Renaissance'25",
    highlight: "Technical leadership for central university fest",
    description: "Coordinating technical operations, event infrastructure, and digital workflows for one of Northern India's largest youth tech-cultural festivals.",
    badge: "Leadership & Community",
    year: "2025"
  }
];
---

<section class="section" id="achievements">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="8" r="7"></circle>
          <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
        </svg>
        Honors & Leadership
      </span>
      <h2 class="section-title">Hackathons & Competitive Honors</h2>
      <p class="section-desc">
        Demonstrated leadership and technical excellence under intense deadline pressure across national competitive hackathons.
      </p>
    </div>

    <div class="achievements-grid">
      {achievements.map((item) => (
        <div class="card achievement-card">
          <div class="achieve-header">
            <span class="achieve-rank">{item.rank}</span>
            <div class="achieve-meta">
              <span class="pill pill-accent">{item.badge}</span>
              <span class="achieve-year">{item.year}</span>
            </div>
          </div>
          <h3 class="achieve-event">{item.event}</h3>
          <p class="achieve-highlight">{item.highlight}</p>
          <p class="achieve-desc">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .achievements-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .achievement-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
  }

  .achieve-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .achieve-rank {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--accent);
  }

  .achieve-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .achieve-year {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .achieve-event {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
    letter-spacing: -0.01em;
  }

  .achieve-highlight {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .achieve-desc {
    font-size: 0.8875rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  @media (max-width: 680px) {
    .achievements-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
